# 서버 환경 변수 예시 (필요한 것만 설정)
PORT=5173                 # 서버 포트. 호스팅 서비스가 정해 주면 그 값을 쓴다
HOST=0.0.0.0              # 다른 기기에서 접속하려면 0.0.0.0
ALLOWED_ORIGINS=          # 비우면 모두 허용. 예: https://my-game.example.com (쉼표로 여러 개)
GRACE_MS=30000            # 연결이 끊긴 사람을 기다려 주는 시간(ms)
TURN_MS=60000             # 한 차례에 쓸 수 있는 시간(ms)
IDLE_ROOM_MS=900000       # 아무 일 없는 방을 닫는 시간(ms)
DEV=                      # 1이면 새로 고침할 때마다 화면을 다시 묶는다(개발용)
